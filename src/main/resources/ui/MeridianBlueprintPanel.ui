$C = "../Common.ui";

$C.@PageOverlay #BlueprintPage {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 460);

    #Title {
      $C.@Title {
        @Text = "Blueprint";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #LayersHeader {
        Anchor: (Bottom: 6);
        Style: (...$C.@DefaultLabelStyle, TextColor: #E8A93B);
        Text: "Layers";
      }

      Label #LayerStatus {
        Anchor: (Bottom: 8);
        Style: $C.@DefaultLabelStyle;
        Text: "";
      }

      Group #LayerRow {
        LayoutMode: Left;
        Anchor: (Bottom: 8, Height: 32);

        $C.@SmallSecondaryTextButton #PrevLayer {
          @Anchor = (Right: 4);
          @Text = "Prev layer";
          FlexWeight: 1;
        }

        $C.@SmallSecondaryTextButton #NextLayer {
          @Anchor = (Left: 4);
          @Text = "Next layer";
          FlexWeight: 1;
        }
      }

      Group #WindowRow {
        LayoutMode: Left;
        Anchor: (Bottom: 8, Height: 32);

        Label #WindowLabel {
          Anchor: (Width: 150);
          Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
          Text: "Layers shown";
        }

        $C.@SmallSecondaryTextButton #WindowLess {
          @Anchor = (Width: 48, Right: 4);
          @Text = "-";
        }

        Label #WindowValue {
          Anchor: (Width: 80);
          Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center, HorizontalAlignment: Center);
          Text: "";
        }

        $C.@SmallSecondaryTextButton #WindowMore {
          @Anchor = (Width: 48, Left: 4, Right: 8);
          @Text = "+";
        }

        $C.@SmallSecondaryTextButton #WindowAll {
          @Anchor = (Left: 4);
          @Text = "All";
          FlexWeight: 1;
        }
      }

      Group {
        Anchor: (Vertical: 8, Height: 1);
        Background: #5e512c(0.0);
      }

      Group #ActionRow {
        LayoutMode: Center;
        Anchor: (Top: 8);

        $C.@TextButton #DoneButton {
          Text: "Done";
          FlexWeight: 1;
        }
      }
    }
  }
}

$C.@BackButton {}
